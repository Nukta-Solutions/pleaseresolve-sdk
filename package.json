{
  "name": "@pleaseresolve/sdk",
  "version": "0.1.2",
  "description": "Embeddable issue-reporting widget for Please Resolve — script tag today, npm package in Phase 3.",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": ["please-resolve", "bug-report", "issue-tracker", "widget", "feedback"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nukta-Solutions/pleaseresolve-sdk.git"
  },
  "homepage": "https://github.com/Nukta-Solutions/pleaseresolve-sdk#readme",
  "bugs": "https://github.com/Nukta-Solutions/pleaseresolve-sdk/issues",
  "type": "module",
  "main": "./dist/sdk.cjs",
  "module": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "require": "./dist/auto.cjs"
    }
  },
  "sideEffects": ["./dist/auto.js", "./dist/auto.cjs"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
